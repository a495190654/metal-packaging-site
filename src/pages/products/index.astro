---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection } from 'astro:content';
import { productCategories } from '../../lib/productCategories';

const products = (await getCollection('products')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);

const filterOptions = [
	{ label: 'All', value: 'all' },
	...productCategories.map((cat) => ({
		label: cat === 'Easy Peel-Off Lids' ? 'Peel-Off Lids' : cat,
		value: cat,
	})),
];
---

<Layout
	title="Product Catalog | Minter Metal Packaging"
	description="Browse Minter's premium easy-open metal packaging — easy open ends, peel-off lids, combination covers, screw lids, and bottom ends."
>
	<Header />
	<main class="bg-slate-900">
		<!-- Hero -->
		<section class="relative overflow-hidden border-b border-slate-800 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
			<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-sky-900/30 via-transparent to-transparent" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
				<p class="text-sm font-semibold uppercase tracking-widest text-sky-400">Minter / 铭泰易拉盖</p>
				<h1 class="mt-3 max-w-3xl text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
					Product Catalog
				</h1>
				<p class="mt-4 max-w-2xl text-lg text-slate-300">
					Premium Easy-Open Metal Packaging — engineered for food safety, seal integrity, and global export compliance.
				</p>
			</div>
		</section>

		<!-- Filter + Grid -->
		<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
			<div
				class="flex flex-wrap gap-2 sm:gap-3"
				role="group"
				aria-label="Filter by category"
				id="category-filters"
			>
				{
					filterOptions.map((opt, i) => (
						<button
							type="button"
							data-category={opt.value}
							class:list={[
								'category-filter rounded-full border px-4 py-2 text-sm font-medium transition',
								i === 0
									? 'border-sky-500 bg-sky-500 text-white shadow-lg shadow-sky-500/25'
									: 'border-slate-600 bg-slate-800 text-slate-300 hover:border-sky-500/60 hover:text-white',
							]}
						>
							{opt.label}
						</button>
					))
				}
			</div>

			<p id="catalog-empty" class="mt-12 hidden text-center text-slate-400">
				No products in this category yet.
			</p>

			<div id="product-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					products.map((product) => {
						const { title, slug, category, mainImage, specifications } = product.data;
						return (
							<article
								class="product-card group flex flex-col overflow-hidden rounded-2xl border border-slate-700/80 bg-slate-800/80 shadow-xl shadow-black/20 transition hover:border-sky-500/40 hover:shadow-sky-900/20"
								data-category={category}
							>
								<a href={`/products/${slug}`} class="relative aspect-[4/3] overflow-hidden bg-slate-900">
									<img
										src={mainImage}
										alt={title}
										width={480}
										height={360}
										class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
										loading="lazy"
									/>
									<span class="absolute left-3 top-3 rounded-full bg-slate-900/80 px-3 py-1 text-xs font-medium text-sky-300 backdrop-blur-sm">
										{category}
									</span>
								</a>
								<div class="flex flex-1 flex-col p-5">
									<h2 class="text-lg font-semibold text-white">
										<a href={`/products/${slug}`} class="hover:text-sky-400 transition">
											{title}
										</a>
									</h2>
									<div class="mt-3 flex flex-wrap gap-2">
										<span class="rounded-md bg-slate-900 px-2.5 py-1 text-xs text-slate-300">
											<span class="text-sky-400">Ø</span> {specifications.diameter}
										</span>
										<span class="rounded-md bg-slate-900 px-2.5 py-1 text-xs text-slate-300">
											{specifications.material}
										</span>
									</div>
									<div class="mt-auto pt-5">
										<a
											href={`/products/${slug}`}
											class="inline-flex w-full items-center justify-center rounded-lg bg-sky-500 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-sky-500/20 transition hover:bg-sky-400"
										>
											View Details &amp; Specs
										</a>
									</div>
								</div>
							</article>
						);
					})
				}
			</div>
		</section>
	</main>
	<Footer />

	<script>
		const filters = document.querySelectorAll<HTMLButtonElement>('.category-filter');
		const cards = document.querySelectorAll<HTMLElement>('.product-card');
		const emptyMsg = document.getElementById('catalog-empty');

		function setActiveFilter(active: HTMLButtonElement) {
			filters.forEach((btn) => {
				const isActive = btn === active;
				btn.classList.toggle('border-sky-500', isActive);
				btn.classList.toggle('bg-sky-500', isActive);
				btn.classList.toggle('text-white', isActive);
				btn.classList.toggle('shadow-lg', isActive);
				btn.classList.toggle('shadow-sky-500/25', isActive);
				btn.classList.toggle('border-slate-600', !isActive);
				btn.classList.toggle('bg-slate-800', !isActive);
				btn.classList.toggle('text-slate-300', !isActive);
			});
		}

		function applyFilter(category: string) {
			let visible = 0;
			cards.forEach((card) => {
				const match = category === 'all' || card.dataset.category === category;
				card.classList.toggle('hidden', !match);
				if (match) visible++;
			});
			emptyMsg?.classList.toggle('hidden', visible > 0);
		}

		filters.forEach((btn) => {
			btn.addEventListener('click', () => {
				setActiveFilter(btn);
				applyFilter(btn.dataset.category ?? 'all');
			});
		});

		const params = new URLSearchParams(window.location.search);
		const initial = params.get('category');
		if (initial) {
			const match = [...filters].find((btn) => btn.dataset.category === initial);
			if (match) {
				setActiveFilter(match);
				applyFilter(initial);
			}
		}
	</script>
</Layout>
