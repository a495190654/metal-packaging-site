---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const products = await getCollection('products');
	return products.map((product) => ({
		params: { slug: product.data.slug },
		props: { product },
	}));
}

interface Props {
	product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { title, slug, category, mainImage, galleryImages, specifications, features } = product.data;
const { Content } = await render(product);

const allProducts = await getCollection('products');
const related = allProducts
	.filter((p) => p.data.category === category && p.data.slug !== slug)
	.slice(0, 4);

const gallery = galleryImages.length > 0 ? galleryImages : [mainImage];
const categoryHref = `/products?category=${encodeURIComponent(category)}`;

const specRows = [
	{ label: 'Diameter', value: specifications.diameter },
	{ label: 'Material', value: specifications.material },
	{ label: 'Internal Coating', value: specifications.internalCoating },
	{ label: 'External Coating', value: specifications.externalCoating },
	{ label: 'Application', value: specifications.application },
];
---

<Layout
	title={`${title} | Minter Metal Packaging`}
	description={`${title} — ${category}. ${specifications.diameter}, ${specifications.material}. Request a sample or quick quote from Minter.`}
>
	<Header />
	<main class="bg-slate-50">
		<!-- Breadcrumb -->
		<nav class="border-b border-slate-200 bg-white" aria-label="Breadcrumb">
			<div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
				<ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500">
					<li><a href="/" class="hover:text-sky-600 transition">Home</a></li>
					<li aria-hidden="true" class="text-slate-300">/</li>
					<li><a href="/products" class="hover:text-sky-600 transition">Products</a></li>
					<li aria-hidden="true" class="text-slate-300">/</li>
					<li>
						<a href={categoryHref} class="hover:text-sky-600 transition">{category}</a>
					</li>
					<li aria-hidden="true" class="text-slate-300">/</li>
					<li class="font-medium text-slate-900" aria-current="page">{title}</li>
				</ol>
			</div>
		</nav>

		<!-- Product detail -->
		<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
			<div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
				<!-- Gallery -->
				<div>
					<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg">
						<img
							id="gallery-main"
							src={gallery[0]}
							alt={title}
							width={640}
							height={640}
							class="aspect-square w-full object-cover"
						/>
					</div>
					{
						gallery.length > 1 && (
							<div class="mt-4 flex gap-3 overflow-x-auto pb-1" role="list" aria-label="Product gallery thumbnails">
								{gallery.map((src, i) => (
									<button
										type="button"
										class:list={[
											'gallery-thumb shrink-0 overflow-hidden rounded-lg border-2 transition',
											i === 0 ? 'border-sky-500 ring-2 ring-sky-500/30' : 'border-slate-200 hover:border-sky-400',
										]}
										data-src={src}
										aria-label={`View image ${i + 1}`}
										aria-pressed={i === 0 ? 'true' : 'false'}
									>
										<img src={src} alt="" width={80} height={80} class="h-20 w-20 object-cover" loading="lazy" />
									</button>
								))}
							</div>
						)
					}
				</div>

				<!-- Info -->
				<div>
					<span class="inline-block rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-sky-700">
						{category}
					</span>
					<h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>

					{
						features.length > 0 && (
							<div class="mt-8">
								<h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Key Features</h2>
								<ul class="mt-3 space-y-2">
									{features.map((feature) => (
										<li class="flex items-start gap-2 text-slate-700">
											<svg class="mt-0.5 h-5 w-5 shrink-0 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
											</svg>
											{feature}
										</li>
									))}
								</ul>
							</div>
						)
					}

					<div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
						<h2 class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-sm font-semibold uppercase tracking-wider text-slate-600">
							Technical Specifications
						</h2>
						<table class="w-full text-sm">
							<tbody>
								{
									specRows.map((row, i) => (
										<tr class:list={[i % 2 === 0 ? 'bg-white' : 'bg-slate-50/80']}>
											<th scope="row" class="w-2/5 px-4 py-3 text-left font-medium text-slate-500">
												{row.label}
											</th>
											<td class="px-4 py-3 text-slate-800">{row.value}</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>

					<a
						href="/#quote"
						class="mt-8 inline-flex w-full items-center justify-center rounded-xl bg-sky-500 px-6 py-4 text-base font-semibold text-white shadow-lg shadow-sky-500/25 transition hover:bg-sky-600 sm:w-auto"
					>
						Request Sample / Quick Quote
					</a>
				</div>
			</div>

			<!-- Description -->
			<div class="prose prose-slate mt-14 max-w-none rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:prose-lg">
				<h2 class="!mt-0 text-xl font-bold text-slate-900">Product Description</h2>
				<Content />
			</div>
		</section>

		<!-- Related products -->
		{
			related.length > 0 && (
				<section class="border-t border-slate-200 bg-slate-900 py-12 sm:py-16">
					<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
						<h2 class="text-2xl font-bold text-white">Related Products</h2>
						<p class="mt-1 text-slate-400">More from {category}</p>
						<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
							{related.map((item) => (
								<a
									href={`/products/${item.data.slug}`}
									class="group overflow-hidden rounded-xl border border-slate-700 bg-slate-800 transition hover:border-sky-500/50"
								>
									<div class="aspect-[4/3] overflow-hidden bg-slate-900">
										<img
											src={item.data.mainImage}
											alt={item.data.title}
											width={320}
											height={240}
											class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
											loading="lazy"
										/>
									</div>
									<div class="p-4">
										<p class="text-xs font-medium text-sky-400">{item.data.category}</p>
										<h3 class="mt-1 font-semibold text-white group-hover:text-sky-300 transition">
											{item.data.title}
										</h3>
									</div>
								</a>
							))}
						</div>
					</div>
				</section>
			)
		}
	</main>
	<Footer />

	<script>
		const mainImg = document.getElementById('gallery-main') as HTMLImageElement | null;
		const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

		thumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => {
				const src = thumb.dataset.src;
				if (!src || !mainImg) return;
				mainImg.src = src;
				thumbs.forEach((t) => {
					const active = t === thumb;
					t.classList.toggle('border-sky-500', active);
					t.classList.toggle('ring-2', active);
					t.classList.toggle('ring-sky-500/30', active);
					t.classList.toggle('border-slate-200', !active);
					t.setAttribute('aria-pressed', active ? 'true' : 'false');
				});
			});
		});
	</script>
</Layout>
