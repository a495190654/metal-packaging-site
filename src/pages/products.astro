---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ProductClassificationGrid from '../components/products/ProductClassificationGrid.astro';
---

<Layout
	title="Products | Minter Metal Packaging"
	description="Browse Minter's full catalog of aluminum and tinplate easy-open ends, peel-off lids, penny lever lids, bottom lids, and lug caps."
>
	<Header />
	<main>
		<div class="border-b border-slate-100 bg-white pt-10 pb-6 sm:pt-12">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Our Products</h1>
				<p class="mt-2 max-w-2xl text-slate-600">
					OEM &amp; ODM metal packaging solutions for global food, beverage, and industrial brands.
				</p>
			</div>
		</div>
		<ProductClassificationGrid showSectionHeader={false} />
	</main>
	<Footer />
</Layout>
