---
// Header 组件：包含 Logo、完整外贸导航与询盘按钮
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      {/* 左侧：Logo 与品牌名称 */}
      <a href="/" class="flex items-center gap-3 group">
        <img src="/minter-logo.png" alt="Minter Logo" class="h-20 w-auto object-contain" />
        <div class="flex flex-col">
          <span class="font-bold text-lg text-slate-900 tracking-tight group-hover:text-sky-600 transition">铭泰易拉盖</span>
          <span class="text-xs text-slate-500 tracking-wider">MINTER B2B</span>
        </div>
      </a>

      {/* 中间：导航链接（完全对齐图1分类） */}
      <nav class="hidden md:flex items-center space-x-8">
        <a href="/" class="text-sky-600 font-medium hover:text-sky-700 transition">Home</a>
        <a href="#products" class="text-slate-600 hover:text-sky-600 transition flex items-center gap-1">
          Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a href="#service" class="text-slate-600 hover:text-sky-600 transition">Custom Service</a>
        <a href="#factory" class="text-slate-600 hover:text-sky-600 transition">Factory Tour</a>
        <a href="#blog" class="text-slate-600 hover:text-sky-600 transition">Blog</a>
        <a href="#about" class="text-slate-600 hover:text-sky-600 transition">About Us</a>
        <a href="#contact" class="text-slate-600 hover:text-sky-600 transition">Contact Us</a>
      </nav>

      {/* 右侧：询盘 CTA 按钮 */}
      <div>
        <a href="#contact" class="bg-sky-600 hover:bg-sky-700 text-white px-5 py-2.5 rounded-lg font-medium shadow-md transition">
          Request a Quote
        </a>
      </div>

    </div>
  </div>
</header>