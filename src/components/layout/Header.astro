---
import { logoSrc } from '../../data/media';

const productLinks = [
	{ label: 'See all categories', href: '/products' },
	{ label: 'Pull Cap', href: '/products?category=Pull%20Cap' },
	{ label: 'Tinplate ETP/TFS Easy Open End', href: '/products?category=Tinplate%20ETP%2FTFS%20Easy%20Open%20End' },
	{ label: 'Aluminum Easy Open End', href: '/products?category=Aluminum%20Easy%20Open%20End' },
	{ label: 'Easy Peel Off Lid', href: '/products?category=Easy%20Peel%20Off%20Lid' },
	{ label: 'Lug Cap/Screw Cap', href: '/products?category=Lug%20Cap%2FScrew%20Cap' },
	{ label: 'Tinplate Bottom', href: '/products?category=Tinplate%20Bottom' },
	{ label: 'Penny Lever Lid', href: '/products?category=Penny%20Lever%20Lid' },
	{ label: 'Ungrouped', href: '/products?category=Ungrouped' },
];

const navLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'Products', href: '/products', children: productLinks },
	{ label: 'Custom Service', href: '/#service' },
	{ label: 'Factory Tour', href: '/#factory' },
	{ label: 'Blog', href: '/blog' },
	{ label: 'About Us', href: '/#about' },
	{ label: 'Contact Us', href: '/#contact' },
];
---

<header
	class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 shadow-sm backdrop-blur-md"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
			<!-- Logo -->
			<a href="/" class="group flex shrink-0 items-center gap-3">
				<img
					src={logoSrc}
					alt="Minter Logo"
					width="120"
					height="48"
					class="h-10 w-auto max-w-[120px] object-contain sm:h-11 lg:h-12"
				/>
				<span class="hidden flex-col sm:flex">
					<span class="text-sm font-bold leading-tight text-slate-900 transition-colors group-hover:text-sky-600 lg:text-base">
						Minter / 铭泰易拉盖
					</span>
					<span class="text-[10px] font-medium uppercase tracking-widest text-slate-500 lg:text-xs">
						Metal Packaging Manufacturer
					</span>
				</span>
			</a>

			<!-- Desktop navigation -->
			<nav class="hidden items-center gap-1 xl:gap-2 lg:flex" aria-label="Main navigation">
				{
					navLinks.map((link) =>
						link.children ? (
							<div class="group relative">
								<a
									href={link.href}
									class="inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-sky-600"
								>
									{link.label}
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="16"
										height="16"
										class="h-4 w-4 shrink-0 transition-transform group-hover:rotate-180"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2"
										aria-hidden="true"
									>
										<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
									</svg>
								</a>
								<div
									class="invisible absolute left-0 top-full z-50 min-w-[240px] translate-y-2 rounded-xl border border-slate-200 bg-white py-2 opacity-0 shadow-lg transition-all group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
								>
									{
										link.children.map((child) => (
											<a
												href={child.href}
												class="block px-4 py-2.5 text-sm text-slate-600 transition-colors hover:bg-sky-50 hover:text-sky-700"
											>
												{child.label}
											</a>
										))
									}
								</div>
							</div>
						) : (
							<a
								href={link.href}
								class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-sky-600"
							>
								{link.label}
							</a>
						),
					)
				}
			</nav>

			<!-- Right: CTA + mobile toggle -->
			<div class="flex items-center gap-2 sm:gap-3">
				<a
					href="/#contact"
					class="hidden rounded-lg bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-sky-600/20 transition-colors hover:bg-sky-700 sm:inline-flex"
				>
					Request a Quote
				</a>

				<button
					type="button"
					id="mobile-menu-btn"
					class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition-colors hover:bg-slate-50 hover:text-sky-600 lg:hidden"
					aria-expanded="false"
					aria-controls="mobile-menu"
					aria-label="Toggle navigation menu"
				>
					<svg
						id="icon-menu-open"
						xmlns="http://www.w3.org/2000/svg"
						width="22"
						height="22"
						class="h-5 w-5"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
					<svg
						id="icon-menu-close"
						xmlns="http://www.w3.org/2000/svg"
						width="22"
						height="22"
						class="hidden h-5 w-5"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile menu -->
	<div id="mobile-menu" class="hidden border-t border-slate-200 bg-white/95 backdrop-blur-md lg:hidden">
		<nav class="mx-auto max-w-7xl space-y-1 px-4 py-4 sm:px-6" aria-label="Mobile navigation">
			{
				navLinks.map((link) =>
					link.children ? (
						<details class="group rounded-lg">
							<summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 [&::-webkit-details-marker]:hidden">
								<span>{link.label}</span>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<div class="ml-3 space-y-1 border-l border-slate-200 py-2 pl-3">
								{
									link.children.map((child) => (
										<a
											href={child.href}
											class="block rounded-lg px-3 py-2 text-sm text-slate-600 transition-colors hover:bg-sky-50 hover:text-sky-700"
										>
											{child.label}
										</a>
									))
								}
							</div>
						</details>
					) : (
						<a
							href={link.href}
							class="mobile-nav-link block rounded-lg px-3 py-3 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 hover:text-sky-600"
						>
							{link.label}
						</a>
					),
				)
			}
			<a
				href="/#contact"
				class="mobile-nav-link mt-2 block rounded-lg bg-sky-600 px-4 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-sky-700"
			>
				Request a Quote
			</a>
		</nav>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	const iconOpen = document.getElementById('icon-menu-open');
	const iconClose = document.getElementById('icon-menu-close');

	btn?.addEventListener('click', () => {
		const isOpen = !menu?.classList.contains('hidden');
		menu?.classList.toggle('hidden', isOpen);
		iconOpen?.classList.toggle('hidden', !isOpen);
		iconClose?.classList.toggle('hidden', isOpen);
		btn?.setAttribute('aria-expanded', String(!isOpen));
	});

	document.querySelectorAll('.mobile-nav-link').forEach((link) => {
		link.addEventListener('click', () => {
			menu?.classList.add('hidden');
			iconOpen?.classList.remove('hidden');
			iconClose?.classList.add('hidden');
			btn?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
