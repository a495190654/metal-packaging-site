---
import { products, marqueeMobileProducts } from '../../data/products';

const tracks = [
	{
		id: 'mobile',
		items: marqueeMobileProducts,
		viewportClass: 'product-marquee__viewport--mobile md:hidden',
		loading: 'eager' as const,
	},
	{
		id: 'desktop',
		items: products,
		viewportClass: 'product-marquee__viewport--desktop hidden md:block',
		loading: 'lazy' as const,
	},
];
---

<section class="product-marquee border-b border-slate-100 bg-white py-8 sm:py-10 lg:py-12" aria-labelledby="hot-products-heading">
	<h2 id="hot-products-heading" class="product-marquee__heading">Hot Products</h2>

	{
		tracks.map(({ id, items, viewportClass, loading }) => (
			<div class={viewportClass} data-marquee-track={id}>
				<div class="product-marquee__track">
					{
						[false, true].map((isDuplicate) => (
							<ul class="product-marquee__group" aria-hidden={isDuplicate ? 'true' : undefined}>
								{items.map((product) => (
									<li class="product-marquee__item">
										<div class="product-card">
											<div class="product-card__media">
												<img
													src={product.src}
													alt={isDuplicate ? '' : product.alt}
													width="250"
													height="250"
													class="product-card__image"
													loading={loading}
													decoding="async"
													fetchpriority={loading === 'eager' ? 'low' : 'auto'}
												/>
											</div>
										</div>
									</li>
								))}
							</ul>
						))
					}
				</div>
			</div>
		))
	}
</section>

<script>
	const LOAD_TIMEOUT_MS = 3000;
	const DESKTOP_MQ = window.matchMedia('(min-width: 768px)');

	function eagerLoadImages(viewport: Element) {
		viewport.querySelectorAll<HTMLImageElement>('.product-card__image').forEach((img) => {
			if (img.loading !== 'eager') {
				img.loading = 'eager';
				const src = img.currentSrc || img.src;
				if (src && !img.complete) {
					img.src = '';
					img.src = src;
				}
			}
		});
	}

	function initMarqueeImages() {
		const viewports = document.querySelectorAll<HTMLElement>('.product-marquee__viewport--mobile, .product-marquee__viewport--desktop');

		viewports.forEach((viewport) => {
			const isDesktopTrack = viewport.dataset.marqueeTrack === 'desktop';
			const isVisible =
				isDesktopTrack ? DESKTOP_MQ.matches : !DESKTOP_MQ.matches;

			if (!isVisible) return;

			if (isDesktopTrack && DESKTOP_MQ.matches) {
				eagerLoadImages(viewport);
			}

			const images = viewport.querySelectorAll<HTMLImageElement>('.product-card__image');

			images.forEach((img) => {
				const media = img.closest('.product-card__media');
				if (!media) return;

				const markError = () => media.classList.add('is-error');

				const slowTimer = window.setTimeout(() => {
					if (!img.complete || img.naturalWidth === 0) {
						media.classList.add('is-slow');
					}
				}, LOAD_TIMEOUT_MS);

				const clearSlowTimer = () => window.clearTimeout(slowTimer);

				if (img.complete && img.naturalWidth > 0) {
					clearSlowTimer();
				} else {
					img.addEventListener('load', () => clearSlowTimer(), { once: true });
					img.addEventListener(
						'error',
						() => {
							clearSlowTimer();
							markError();
						},
						{ once: true },
					);
				}
			});
		});
	}

	initMarqueeImages();
	DESKTOP_MQ.addEventListener('change', initMarqueeImages);
	document.addEventListener('astro:page-load', initMarqueeImages);
</script>

<style is:global>
	.product-marquee {
		width: 100%;
		max-width: none;
	}

	.product-marquee__heading {
		margin: 0 0 1.5rem;
		text-align: center;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: rgb(100 116 139);
	}

	.product-marquee__viewport--mobile,
	.product-marquee__viewport--desktop {
		overflow: hidden;
		width: 100%;
		max-width: none;
		min-height: 250px;
	}

	.product-marquee__track {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: stretch;
		width: max-content;
		min-width: max-content;
		flex-shrink: 0;
		animation: product-marquee-scroll 45s linear infinite;
		will-change: transform;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		transform: translate3d(0, 0, 0);
	}

	.product-marquee__viewport--mobile:hover .product-marquee__track,
	.product-marquee__viewport--desktop:hover .product-marquee__track {
		animation-play-state: paused;
	}

	.product-marquee__group {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		flex: 0 0 auto;
		flex-shrink: 0;
		align-items: stretch;
		width: max-content;
		min-width: max-content;
		gap: 1.5rem;
		margin: 0;
		padding: 0 0.75rem;
		list-style: none;
	}

	.product-marquee__item {
		display: block;
		flex: 0 0 auto;
		flex-shrink: 0;
		min-width: 250px;
		width: 250px;
	}

	.product-card {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		min-width: 250px;
		width: 250px;
		height: 250px;
		margin: 0;
		padding: 0.875rem;
		border: 1px solid rgb(226 232 240);
		border-radius: 0.875rem;
		background: rgb(255 255 255);
		box-shadow: 0 1px 8px rgb(15 23 42 / 0.06);
	}

	.product-card__media {
		display: flex;
		flex: 1 1 auto;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		min-height: 180px;
		border: 1px solid rgb(241 245 249);
		border-radius: 0.5rem;
		background: rgb(248 250 252);
		overflow: hidden;
	}

	.product-card__media.is-error .product-card__image {
		opacity: 0;
	}

	.product-card__image {
		display: block;
		max-width: 100%;
		height: auto;
		width: 100%;
		object-fit: contain;
		object-position: center;
	}

	@keyframes product-marquee-scroll {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}
</style>
