---
import { Image } from 'astro:assets';
import { products } from '../../data/products';
---

<section class="product-marquee bg-slate-950 py-8 sm:py-10 lg:py-12" aria-labelledby="hot-products-heading">
	<h2 id="hot-products-heading" class="product-marquee__heading">Hot Products</h2>

	<div class="product-marquee__viewport">
		<div class="product-marquee__track">
			{
				[false, true].map((isDuplicate) => (
					<ul class="product-marquee__group" aria-hidden={isDuplicate ? 'true' : undefined}>
						{products.map((product) => (
							<li class="product-marquee__item">
								<div class="product-card">
									<div class="product-card__media is-loading">
										<Image
											src={product.image}
											alt={isDuplicate ? '' : product.alt}
											width={250}
											height={250}
											widths={[180, 220, 250]}
											sizes="(max-width: 640px) 180px, 250px"
											loading="lazy"
											decoding="async"
											class="product-card__image"
										/>
									</div>
								</div>
							</li>
						))}
					</ul>
				))
			}
		</div>
	</div>
</section>

<script>
	const LOAD_TIMEOUT_MS = 3000;

	function initMarqueeImages() {
		const viewport = document.querySelector('.product-marquee__viewport');
		if (!viewport) return;

		const images = viewport.querySelectorAll<HTMLImageElement>('.product-card__image');

		images.forEach((img) => {
			const media = img.closest('.product-card__media');
			if (!media) return;

			const markLoaded = () => {
				media.classList.remove('is-loading', 'is-slow');
				media.classList.add('is-loaded');
			};

			const markError = () => {
				media.classList.remove('is-loading', 'is-slow');
				media.classList.add('is-error');
				img.hidden = true;
			};

			const slowTimer = window.setTimeout(() => {
				if (!img.complete || img.naturalWidth === 0) {
					media.classList.add('is-slow');
				}
			}, LOAD_TIMEOUT_MS);

			const clearSlowTimer = () => window.clearTimeout(slowTimer);

			if (img.complete && img.naturalWidth > 0) {
				clearSlowTimer();
				markLoaded();
			} else {
				img.addEventListener(
					'load',
					() => {
						clearSlowTimer();
						markLoaded();
					},
					{ once: true },
				);
				img.addEventListener(
					'error',
					() => {
						clearSlowTimer();
						markError();
					},
					{ once: true },
				);
			}
		});

		// 懒加载在 transform 动画容器内可能失效，用 IO 提前触发即将进入视口的图片
		if (!('IntersectionObserver' in window)) return;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;

					const img = entry.target;
					if (!(img instanceof HTMLImageElement) || img.complete) return;

					img.loading = 'eager';
					const src = img.currentSrc || img.src;
					if (src) {
						img.src = '';
						img.src = src;
					}
				});
			},
			{ root: null, rootMargin: '0px 320px', threshold: 0 },
		);

		images.forEach((img) => observer.observe(img));
	}

	initMarqueeImages();
	document.addEventListener('astro:page-load', initMarqueeImages);
</script>

<style is:global>
	.product-marquee {
		width: 100%;
		max-width: none;
	}

	.product-marquee__heading {
		margin: 0 0 1.5rem;
		text-align: center;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: rgb(148 163 184);
	}

	.product-marquee__viewport {
		overflow: hidden;
		width: 100%;
		max-width: none;
	}

	.product-marquee__track {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: stretch;
		width: max-content;
		flex-shrink: 0;
		animation: product-marquee-scroll 45s linear infinite;
		will-change: transform;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		transform: translate3d(0, 0, 0);
	}

	.product-marquee__viewport:hover .product-marquee__track {
		animation-play-state: paused;
	}

	.product-marquee__group {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		flex-shrink: 0;
		align-items: stretch;
		gap: 1.5rem;
		margin: 0;
		padding: 0 0.75rem;
		list-style: none;
	}

	.product-marquee__item {
		display: block;
		flex: 0 0 auto;
		min-width: 250px;
	}

	.product-card {
		display: flex;
		flex-direction: column;
		min-width: 250px;
		width: 250px;
		height: 250px;
		margin: 0;
		padding: 0.875rem;
		border: 1px solid rgb(100 116 139);
		border-radius: 0.875rem;
		background: rgb(15 23 42);
		box-shadow: 0 4px 20px rgb(0 0 0 / 0.3);
	}

	.product-card__media {
		display: flex;
		flex: 1 1 auto;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 180px;
		border: 1px solid rgb(100 116 139);
		border-radius: 0.5rem;
		background: rgb(71 85 105);
		overflow: hidden;
	}

	.product-card__media.is-loading .product-card__image,
	.product-card__media.is-slow .product-card__image {
		opacity: 0;
	}

	.product-card__media.is-loaded .product-card__image {
		opacity: 1;
		transition: opacity 0.25s ease;
	}

	.product-card__media.is-error {
		background: rgb(71 85 105);
	}

	.product-card__image {
		display: block;
		max-width: 100%;
		height: auto;
		width: 100%;
		object-fit: contain;
		object-position: center;
	}

	@keyframes product-marquee-scroll {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}
</style>
