---
import { ourCertificateImageSrc } from '../../data/media';
---

<section id="certificate" class="bg-white py-16 sm:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto mb-10 max-w-3xl text-center sm:mb-12">
			<span class="text-sm font-semibold uppercase tracking-wider text-sky-600">Our Certificate</span>
			<h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 lg:text-4xl">OUR CERTIFICATE</h2>
			<p class="mt-3 text-base text-slate-600">
				Tested &amp; Certified by CPST and International Quality Standards for Food-Grade Packaging Safety.
			</p>
		</div>

		<div class="mx-auto max-w-5xl">
			<figure
				class="group overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 p-3 shadow-md transition hover:shadow-xl sm:p-4"
			>
				<div class="overflow-hidden rounded-xl bg-white">
					<img
						src={ourCertificateImageSrc}
						alt="Mingtai Product Quality Testing Reports and Certificates (CPST Certified)"
						width="1600"
						height="900"
						loading="lazy"
						decoding="async"
						class="mx-auto w-full object-contain transition duration-300 group-hover:drop-shadow-lg"
					/>
				</div>
				<figcaption class="mt-4 text-center text-sm text-slate-500">
					CPST-certified testing reports and compliance documentation available for buyer due diligence.
				</figcaption>
			</figure>
		</div>
	</div>
</section>
