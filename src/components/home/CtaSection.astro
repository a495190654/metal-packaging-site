<section id="quote" class="bg-slate-900 py-20 text-white sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-amber-400">Get Started</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
					Ready to Source? Let's Build Your Next Product Line.
				</h2>
				<p class="mt-4 text-lg text-slate-300">
					Share your requirements and our export team will respond within 24 hours with MOQ, lead
					time, and pricing options tailored to your market.
				</p>

				<ul class="mt-8 space-y-3 text-slate-300">
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="mt-0.5 h-5 w-5 max-w-full shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
						</svg>
						Free sample evaluation for qualified B2B buyers
					</li>
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="mt-0.5 h-5 w-5 max-w-full shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
						</svg>
						NPI to mass production project management
					</li>
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="mt-0.5 h-5 w-5 max-w-full shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
						</svg>
						English-speaking sales and engineering support
					</li>
				</ul>
			</div>

			<div id="contact" class="rounded-2xl border border-slate-700 bg-slate-800/50 p-6 sm:p-8">
				<h3 class="text-xl font-semibold">Request a Quote</h3>
				<p class="mt-1 text-sm text-slate-400">Fill in your details and we'll get back to you promptly.</p>

				<form
					class="mt-6 space-y-4"
					action="mailto:sales@prohair-mfg.com"
					method="GET"
					enctype="text/plain"
				>
					<div>
						<label for="company" class="block text-sm font-medium text-slate-300">Company Name</label>
						<input
							type="text"
							id="company"
							name="company"
							required
							class="mt-1.5 w-full rounded-lg border border-slate-600 bg-slate-900 px-4 py-2.5 text-white placeholder:text-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
							placeholder="Your company"
						/>
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-slate-300">Business Email</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							class="mt-1.5 w-full rounded-lg border border-slate-600 bg-slate-900 px-4 py-2.5 text-white placeholder:text-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
							placeholder="you@company.com"
						/>
					</div>
					<div>
						<label for="message" class="block text-sm font-medium text-slate-300">Inquiry Details</label>
						<textarea
							id="message"
							name="body"
							rows="4"
							required
							class="mt-1.5 w-full resize-y rounded-lg border border-slate-600 bg-slate-900 px-4 py-2.5 text-white placeholder:text-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
							placeholder="Product type, estimated quantity, target market..."
						></textarea>
					</div>
					<button
						type="submit"
						class="w-full rounded-lg bg-amber-500 px-6 py-3 text-base font-semibold text-white transition hover:bg-amber-400"
					>
						Send Inquiry
					</button>
				</form>

				<p class="mt-4 text-center text-xs text-slate-500">
					Or email us directly at{' '}
					<a href="mailto:sales@prohair-mfg.com" class="text-amber-400 hover:underline">
						sales@prohair-mfg.com
					</a>
				</p>
			</div>
		</div>
	</div>
</section>
