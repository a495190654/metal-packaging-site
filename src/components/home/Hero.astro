---
const products = [
	{
		src: '/hero-product-gold.png',
		alt: 'Gold easy-open end with ring pull tab',
		label: 'Tinplate EOE',
	},
	{
		src: '/hero-product-silver.png',
		alt: 'Silver aluminum easy-open end lid',
		label: 'Aluminum EOE',
	},
	{
		src: '/hero-product-peel.png',
		alt: 'Peel-off foil easy-open lid',
		label: 'Peel-off Lid',
	},
];

const valuePoints = ['Reasonable Price', 'Reputation First', 'High-Quality'];
---

<section class="relative overflow-hidden bg-slate-900">
	<!-- 背景产线图：全端显示，移动端遮罩更轻以便看见底图 -->
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<img
			src="/hero-bg.png"
			alt=""
			width="1920"
			height="1080"
			class="h-full w-full object-cover object-[center_35%] brightness-125 sm:object-center lg:brightness-110"
		/>
		<!-- 移动端：自上而下渐弱遮罩，保留底图可见度 -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-slate-950/75 via-slate-900/50 to-slate-800/25 lg:hidden"
		></div>
		<!-- 桌面端：左右渐变遮罩 -->
		<div
			class="absolute inset-0 hidden bg-gradient-to-r from-slate-950/80 via-slate-900/65 to-slate-800/35 lg:block"
		></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 pt-6 pb-8 sm:px-6 sm:pt-8 sm:pb-10 lg:px-8 lg:py-16">
		<div class="grid grid-cols-1 items-center gap-5 sm:gap-6 lg:grid-cols-2 lg:gap-16">
			<!-- 左栏：文案 -->
			<div class="order-1 lg:text-left">
				<div class="max-lg:rounded-2xl max-lg:bg-slate-950/30 max-lg:px-1 max-lg:py-2 max-lg:backdrop-blur-[2px]">
				<span
					class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-sky-600/90 px-3 py-1 text-[11px] font-semibold tracking-wide text-white shadow-sm backdrop-blur-sm sm:text-xs"
				>
					<svg
						class="h-3.5 w-3.5 shrink-0"
						width="14"
						height="14"
						fill="currentColor"
						viewBox="0 0 20 20"
						aria-hidden="true"
					>
						<path
							d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.683-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.565-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
						></path>
					</svg>
					Over 13 Years • OEM &amp; ODM
				</span>

				<h1
					class="text-2xl font-extrabold leading-snug tracking-tight text-white drop-shadow-md sm:text-3xl lg:text-5xl xl:text-[3.25rem]"
				>
					Professional
					<span class="text-sky-400"> Easy Open End</span>
					&amp; Custom Metal Packaging
				</h1>

				<p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-300 drop-shadow-sm sm:text-base lg:mt-4 lg:text-lg">
					Dedicated to high-quality metal packaging for global food, beverage, and packaging brands.
				</p>
				</div>

				<!-- 桌面端：价值点放在文案区 -->
				<ul class="mt-4 hidden flex-wrap gap-x-5 gap-y-2 text-sm text-slate-300 lg:flex">
					{
						valuePoints.map((point) => (
							<li class="flex items-center gap-1.5">
								<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-500" aria-hidden="true"></span>
								<span class="font-medium text-white">{point}</span>
							</li>
						))
					}
				</ul>

				<!-- 桌面端：按钮在文案下方 -->
				<div class="mt-6 hidden flex-col gap-3 sm:flex-row sm:items-center lg:flex lg:justify-start">
					<a
						href="#products"
						class="inline-flex items-center justify-center rounded-xl bg-sky-600 px-6 py-3 text-center text-sm font-semibold text-white shadow-lg transition hover:bg-sky-700 sm:text-base"
					>
						Explore Products
					</a>
					<a
						href="#contact"
						class="inline-flex items-center justify-center rounded-xl border border-white/25 bg-white/10 px-6 py-3 text-center text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20 sm:text-base"
					>
						Request OEM/ODM Quote
					</a>
				</div>
			</div>

			<!-- 产品图（移动端紧跟文案，优先展示） -->
			<div class="order-2">
				<div
					class="rounded-2xl border border-white/10 bg-white/95 p-4 shadow-2xl shadow-black/20 backdrop-blur-sm sm:p-5 lg:bg-white/90"
				>
					<p class="mb-3 text-center text-[10px] font-semibold uppercase tracking-widest text-slate-500 sm:text-xs lg:text-left">
						Featured Easy Open End
					</p>

					<div class="grid grid-cols-3 gap-2 sm:gap-3">
						{
							products.map((product) => (
								<figure class="group flex flex-col items-center text-center">
									<div class="flex aspect-square w-full items-center justify-center overflow-hidden rounded-xl bg-slate-50 p-1.5 sm:p-2">
										<img
											src={product.src}
											alt={product.alt}
											width="320"
											height="320"
											loading="eager"
											decoding="async"
											class="h-auto max-h-full w-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
										/>
									</div>
									<figcaption class="mt-1.5 text-[10px] font-medium leading-tight text-slate-600 sm:text-xs">
										{product.label}
									</figcaption>
								</figure>
							))
						}
					</div>
				</div>
			</div>

			<!-- 移动端：价值点 + 按钮放在产品图下方，不影响产品图优先展示 -->
			<div class="order-3 lg:hidden">
				<ul class="mb-3 flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-slate-300 sm:text-sm">
					{
						valuePoints.map((point) => (
							<li class="flex items-center gap-1.5">
								<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-500" aria-hidden="true"></span>
								<span class="font-medium text-white">{point}</span>
							</li>
						))
					}
				</ul>
				<div class="flex flex-col gap-2.5 sm:flex-row sm:items-center">
				<a
					href="#products"
					class="inline-flex items-center justify-center rounded-xl bg-sky-600 px-6 py-3 text-center text-sm font-semibold text-white shadow-lg transition hover:bg-sky-700"
				>
					Explore Products
				</a>
				<a
					href="#contact"
					class="inline-flex items-center justify-center rounded-xl border border-white/25 bg-white/10 px-6 py-3 text-center text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"
				>
					Request OEM/ODM Quote
				</a>
				</div>
			</div>
		</div>
	</div>
</section>
