---
const products = [
	{
		src: '/hero-product-gold.png',
		alt: 'Gold easy-open end with ring pull tab',
		label: 'Tinplate EOE',
	},
	{
		src: '/hero-product-silver.png',
		alt: 'Silver aluminum easy-open end lid',
		label: 'Aluminum EOE',
	},
	{
		src: '/hero-product-peel.png',
		alt: 'Peel-off foil easy-open lid',
		label: 'Peel-off Lid',
	},
];
---

<section class="relative overflow-hidden bg-slate-900">
	<!-- 桌面端：右侧区域背景产线图（移动端隐藏，避免遮挡文字） -->
	<div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
		<img
			src="/hero-bg.png"
			alt=""
			width="1920"
			height="1080"
			class="h-full w-full object-cover object-center"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/95 to-slate-900/60"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
		<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
			<!-- 左栏：文案（移动端在上，桌面端居左） -->
			<div class="order-1 lg:text-left">
				<span
					class="mb-5 inline-flex items-center gap-2 rounded-full bg-sky-600/90 px-4 py-1.5 text-xs font-semibold tracking-wide text-white shadow-sm backdrop-blur-sm sm:text-sm"
				>
					<svg
						class="h-4 w-4 shrink-0"
						width="16"
						height="16"
						fill="currentColor"
						viewBox="0 0 20 20"
						aria-hidden="true"
					>
						<path
							d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.683-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.565-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
						></path>
					</svg>
					Over 13 Years of Manufacturing Excellence • OEM &amp; ODM
				</span>

				<h1
					class="text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl xl:text-[3.25rem]"
				>
					Professional
					<span class="text-sky-400"> Easy Open Ends</span>
					&amp; Custom Metal Packaging
				</h1>

				<p class="mt-5 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg lg:mx-0">
					Dedicated to <strong class="font-medium text-white">High-Quality</strong> products at a
					<strong class="font-medium text-white">Reasonable Price</strong>. Backed by strict quality
					control and <strong class="font-medium text-white">Reputation First</strong>, serving global
					food, beverage, and packaging brands.
				</p>

				<ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-300 sm:text-base">
					<li class="flex items-center gap-2">
						<span class="h-2 w-2 shrink-0 rounded-full bg-red-500" aria-hidden="true"></span>
						Reasonable Price
					</li>
					<li class="flex items-center gap-2">
						<span class="h-2 w-2 shrink-0 rounded-full bg-red-500" aria-hidden="true"></span>
						Reputation First
					</li>
					<li class="flex items-center gap-2">
						<span class="h-2 w-2 shrink-0 rounded-full bg-red-500" aria-hidden="true"></span>
						High-Quality
					</li>
				</ul>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center lg:justify-start">
					<a
						href="#products"
						class="inline-flex items-center justify-center rounded-xl bg-sky-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg transition hover:bg-sky-700"
					>
						Explore Products
					</a>
					<a
						href="#contact"
						class="inline-flex items-center justify-center rounded-xl border border-white/25 bg-white/10 px-7 py-3.5 text-center text-base font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"
					>
						Request OEM/ODM Quote
					</a>
				</div>
			</div>

			<!-- 右栏：产品图（移动端在下） -->
			<div class="order-2">
				<div
					class="rounded-2xl border border-white/10 bg-white/95 p-5 shadow-2xl shadow-black/20 backdrop-blur-sm sm:p-6 lg:bg-white/90"
				>
					<p class="mb-4 text-center text-xs font-semibold uppercase tracking-widest text-slate-500 lg:text-left">
						Featured Easy Open Ends
					</p>

					<div class="grid grid-cols-3 gap-3 sm:gap-4">
						{
							products.map((product) => (
								<figure class="group flex flex-col items-center text-center">
									<div class="flex aspect-square w-full items-center justify-center overflow-hidden rounded-xl bg-slate-50 p-2 sm:p-3">
										<img
											src={product.src}
											alt={product.alt}
											width="320"
											height="320"
											loading="eager"
											decoding="async"
											class="h-auto max-h-full w-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
										/>
									</div>
									<figcaption class="mt-2 text-[10px] font-medium leading-tight text-slate-600 sm:text-xs">
										{product.label}
									</figcaption>
								</figure>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
