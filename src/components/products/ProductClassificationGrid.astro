---
import { categories } from '../../data/categories';

interface Props {
	showSectionHeader?: boolean;
}

const { showSectionHeader = true } = Astro.props;
---

<section id="products" class="border-t border-slate-100 bg-white py-16 sm:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		{
			showSectionHeader && (
				<div class="mb-10 flex flex-col justify-between gap-4 md:mb-12 md:flex-row md:items-end">
					<div>
						<span class="text-sm font-semibold uppercase tracking-wider text-sky-600">
							Product Categories
						</span>
						<h2 class="mt-1 text-3xl font-bold tracking-tight text-slate-900 lg:text-4xl">
							Comprehensive Metal Packaging Catalog
						</h2>
						<p class="mt-2 max-w-2xl text-base text-slate-600">
							Explore our complete manufacturing lines of easy-open ends, peel-off lids, and matching
							industrial closures.
						</p>
					</div>
					<a
						href="/products"
						class="group inline-flex items-center gap-2 text-sm font-semibold text-sky-600 transition-colors hover:text-sky-700"
					>
						View full catalog
						<span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
							&rarr;
						</span>
					</a>
				</div>
			)
		}

		<div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:gap-7">
			{
				categories.map((category) => (
					<article
						class:list={[
							'group relative flex flex-col overflow-hidden rounded-xl border bg-white transition-shadow hover:shadow-md sm:flex-row sm:items-stretch',
							category.featured
								? 'border-amber-400/60 ring-1 ring-amber-400/25'
								: 'border-slate-200 hover:border-slate-300',
						]}
					>
						{category.featured && (
							<span class="absolute right-3 top-3 z-10 rounded-full bg-amber-500 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow-sm">
								Hot
							</span>
						)}

						<div class="flex shrink-0 items-center justify-center bg-slate-50 p-4 sm:w-[42%] sm:p-5">
							<div class="flex aspect-square w-full max-w-[180px] items-center justify-center sm:max-w-none">
								<img
									src={category.image}
									alt={category.imageAlt}
									width="220"
									height="220"
									loading="lazy"
									decoding="async"
									class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]"
								/>
							</div>
						</div>

						<div class="flex flex-1 flex-col justify-between gap-4 p-5 sm:p-6">
							<div>
								<h3 class="text-lg font-bold leading-snug text-slate-900 sm:text-xl">{category.title}</h3>
								<ul class="mt-3 space-y-1.5 text-sm text-slate-600">
									{category.highlights.map((point) => (
										<li class="flex items-center gap-2">
											<span
												class="h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"
												aria-hidden="true"
											/>
											<span>{point}</span>
										</li>
									))}
								</ul>
							</div>

							<a
								href={category.href}
								class="more-link inline-flex items-center gap-1 self-start text-sm font-semibold tracking-wide text-sky-600 transition-all hover:translate-x-1 hover:text-sky-700"
							>
								MORE &gt;&gt;
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.more-link {
		letter-spacing: 0.04em;
	}
</style>
