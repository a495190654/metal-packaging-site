---
import '../styles/global.css';
import { r2Url, R2_FOLDERS } from '../data/media';

interface Props {
	title?: string;
	description?: string;
}

const faviconSrc = `${r2Url(R2_FOLDERS.factory, 'logo.png')}?v=2`;

const {
	title = 'ProHair Manufacturing | OEM/ODM Hair Dryer & Personal Care Factory',
	description = 'Leading B2B manufacturer of professional hair dryers and personal care appliances. OEM/ODM services, ISO-certified production, and global export to 80+ countries.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href={faviconSrc} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased">
		<slot />
	</body>
</html>
